ti_mpu6050_test/*.out
ti_mpu6050_test/*.map
ti_mpu6050_test/ti_msp_dl_config.c
ti_mpu6050_test/ti_msp_dl_config.h
ti_mpu6050_test/device.opt
ti_mpu6050_test/device.cmd.genlibs
ti_mpu6050_test/device_linker.cmd
ti_mpu6050_test/*.log
ti_control/*.obj
ti_control/*.out
ti_control/*.map
ti_control/ti_msp_dl_config.c
ti_control/ti_msp_dl_config.h
